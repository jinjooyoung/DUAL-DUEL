  m_Script: {fileID: 11500000, guid: e94bcc55c784a3f4f8820dbdcfd0282a, type: 3}
  m_Name: DialogueTable
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTableSO
  lines:
  - id: 0
    characterName: ALICE
    text: "[SYSTEM] \uC548\uB155\uD558\uC138\uC694! DUAL DUEL\uC5D0 \uC624\uC2E0
      \uAC83\uC744 \uC9C4\uC2EC\uC73C\uB85C \uD658\uC601\uD569\uB2C8\uB2E4."
    nextId: 1
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 1
    characterName: ALICE
    text: "[GUIDE] \uC800\uB294 \uB2F9\uC2E0\uC758 \uC804\uD22C\uB97C \uB3D5\uB294
      \uC548\uB0B4 \uB3C4\uC6B0\uBBF8 ALICE\uC608\uC694.\\n\uB05D\uAE4C\uC9C0 \uAC08
      \uC218 \uC788\uB3C4\uB85D \uCE5C\uC808\uD558\uAC8C \uC548\uB0B4\uD574 \uB4DC\uB9B4\uAC8C\uC694!"
    nextId: 2
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 2
    characterName: ALICE
    text: "[GUIDE] \uC774\uACF3\uC740 \uC2A4\uD14C\uC774\uC9C0 \uC120\uD0DD \uD654\uBA74\uC774\uC5D0\uC694.
      \uCE78\uB9C8\uB2E4 \uC804\uD22C, \uC0C1\uC810, \uC815\uBE44\uC18C\uAC00 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uB2F5\uB2C8\uB2E4."
    nextId: 3
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 3
    characterName: ALICE
    text: "[TIP] \uD654\uBA74\uC744 \uB4DC\uB798\uADF8\uD558\uAC70\uB098 \uC2A4\uD06C\uB864\uD558\uBA74
      \uC55E\uC73C\uB85C \uB098\uC544\uAC08 \uC2A4\uD14C\uC774\uC9C0\uB97C \uBBF8\uB9AC
      \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694!"
    nextId: 4
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 4
    characterName: ALICE
    text: "[TIP] \uADF8\uB9AC\uACE0 \uC5B8\uC81C\uB4E0\uC9C0 ESC \uD0A4\uB97C \uB204\uB974\uBA74
      \uC124\uC815 \uCC3D\uB3C4 \uC5F4 \uC218 \uC788\uACE0\uC694."
    nextId: 5
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 5
    characterName: ALICE
    text: "[GUIDE] \uC790, \uB9E8 \uC67C\uCABD\uC758 \uCCAB \uBC88\uC9F8 \uC2A4\uD14C\uC774\uC9C0\uB97C
      \uC544\uBB34\uAC70\uB098 \uD074\uB9AD\uD574 \uBCF4\uC138\uC694. \uC800\uB97C
      \uBBFF\uC73C\uC154\uB3C4 \uC88B\uC544\uC694."
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 6
    characterName: ALICE
    text: "[SYSTEM] \uD6CC\uB96D\uD569\uB2C8\uB2E4! \uC624\uB978\uCABD \uD328\uB110\uC5D0
      \uC2A4\uD14C\uC774\uC9C0 \uC815\uBCF4\uAC00 \uD45C\uC2DC\uB418\uC5C8\uC5B4\uC694.\\n\uC900\uBE44\uB418\uC168\uB2E4\uBA74
      \uC785\uC7A5 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 10
    characterName: ALICE
    text: "[GUIDE] \uD574\uB2F9 \uC2A4\uD14C\uC774\uC9C0\uB294 \uC0C1\uC810 \uC2A4\uD14C\uC774\uC9C0\uC608\uC694!"
    nextId: 11
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 11
    characterName: ALICE
    text: "[GUIDE] \uC67C\uCABD \uC704\uC5D0 \uBCF4\uC774\uB294 \uC18C\uC9C0\uAE08\uC73C\uB85C
      \uC0C1\uC810\uC5D0\uC11C \uCE74\uB4DC\uB97C \uAD6C\uB9E4\uD560 \uC218 \uC788\uC5B4\uC694!"
    nextId: 12
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 12
    characterName: ALICE
    text: "[TIP] \uB3C8\uC774 \uBD80\uC871\uD558\uB2E4\uBA74 \uC544\uBB34\uAC83\uB3C4
      \uAD6C\uB9E4\uD558\uC9C0 \uBABB\uD558\uACE0 \uB098\uC624\uAC8C \uB420 \uAC70\uC608\uC694..."
    nextId: 13
    portraitPath: Dialogue/Guide
    expression: Sad
    action: 
  - id: 13
    characterName: ALICE
    text: "[TIP] \uB3C8\uC740 \uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD558\uBA74 \uC5BB\uC744
      \uC218 \uC788\uC5B4\uC694!\\n\uB354 \uAC15\uB825\uD55C \uC801\uC744 \uCC98\uCE58\uD558\uBA74
      \uB354 \uB9CE\uC740 \uB3C8\uC744 \uC5BB\uB294\uB2F5\uB2C8\uB2E4."
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 20
    characterName: ALICE
    text: "[GUIDE] \uD574\uB2F9 \uC2A4\uD14C\uC774\uC9C0\uB294 \uC815\uBE44\uC18C
      \uC2A4\uD14C\uC774\uC9C0\uC608\uC694!"
    nextId: 21
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 21
    characterName: ALICE
    text: "[GUIDE] \uD68C\uBCF5, \uCE74\uB4DC \uAC15\uD654, \uCE74\uB4DC \uC0AD\uC81C
      \uC911 \uB2E8 1\uAC00\uC9C0\uB9CC\uC744 \uC120\uD0DD\uD560 \uC218 \uC788\uC5B4\uC694."
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 30
    characterName: ALICE
    text: "[GUIDE] \uD574\uB2F9 \uC2A4\uD14C\uC774\uC9C0\uB294 \uB79C\uB364 \uC2A4\uD14C\uC774\uC9C0\uC608\uC694!"
    nextId: 31
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 31
    characterName: ALICE
    text: "[GUIDE] \uC804\uD22C, \uC0C1\uC810\uBD80\uD130 \uC815\uBE44\uC18C\uAE4C\uC9C0
      \uBB34\uC5C7\uC774 \uB098\uC62C\uC9C0 \uC54C \uC218 \uC5C6\uB294 \uC2A4\uD14C\uC774\uC9C0\uC608\uC694."
    nextId: 32
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 32
    characterName: ALICE
    text: "[SYSTEM] \uBB3C\uB860 \uC800\uB294 \uC54C\uACE0 \uC788\uC9C0\uB9CC, \uB9D0\uC500\uD574
      \uB4DC\uB9B4 \uC218 \uC5C6\uC5B4\uC694!"
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Sad
    action: 
  - id: 50
    characterName: ALICE
    text: "[SYSTEM] \uC804\uD22C \uC2DC\uBBAC\uB808\uC774\uC158\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    nextId: 51
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 51
    characterName: ALICE
    text: "[GUIDE] \uC911\uC559\uC5D0 \uC788\uB294 5\uAC1C\uC758 \uC2AC\uB86F\uC5D0
      \uC6D0\uD558\uB294 \uB9CC\uD07C \uCE74\uB4DC\uB97C \uB4DC\uB798\uADF8\uD558\uC5EC
      \uBC30\uCE58\uD55C \uB4A4, [\uD134 \uC885\uB8CC] \uBC84\uD2BC\uC744 \uB204\uB974\uBA74
      \uB3FC\uC694."
    nextId: 52
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 52
    characterName: ALICE
    text: "[GUIDE] \uC7A0\uAE50! \uC131\uAE09\uD558\uAC8C \uD558\uC9C0 \uC54A\uC544\uB3C4
      \uAD1C\uCC2E\uC544\uC694.\\n\uBC1D\uC740 \uC2AC\uB86F\uC740 \uB2F9\uC2E0\uC758
      \uD589\uB3D9 \uAD6C\uC5ED, \uC5B4\uB450\uC6B4 \uC2AC\uB86F\uC740 \uC801\uC758
      \uD589\uB3D9 \uAD6C\uC5ED\uC774\uC5D0\uC694."
    nextId: 53
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 53
    characterName: ALICE
    text: "[GUIDE] \uAC19\uC740 \uACF5\uACA9 \uCE74\uB4DC\uB354\uB77C\uB3C4 \uBC1D\uC740
      \uC2AC\uB86F\uC5D0 \uB193\uC73C\uBA74 \uB2F9\uC2E0\uC774 \uC801\uC744 \uACF5\uACA9\uD558\uACE0,\\n\uC5B4\uB450\uC6B4
      \uC2AC\uB86F\uC5D0 \uB193\uC73C\uBA74 \uC801\uC774 \uB2F9\uC2E0\uC744 \uACF5\uACA9\uD574\uC694."
    nextId: 54
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 54
    characterName: ALICE
    text: "[TIP] \uC2AC\uB86F\uC744 \uC804\uBD80 \uCC44\uC6B8 \uD544\uC694\uB294
      \uC5C6\uB2F5\uB2C8\uB2E4. \uB2F9\uC2E0\uC758 \uD310\uB2E8\uC774 \uB05D\uB0AC\uB2E4\uBA74
      \uC5B8\uC81C\uB4E0 \uC790\uC720\uB86D\uAC8C \uD134\uC744 \uC885\uB8CC\uD560
      \uC218 \uC788\uC5B4\uC694!"
    nextId: 55
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 55
    characterName: ALICE
    text: "[WARNING] \uD558\uC9C0\uB9CC \uB9CC\uC57D \uCE74\uB4DC\uB97C \uB193\uC9C0
      \uC54A\uC558\uB2E4\uBA74, \uD574\uB2F9 \uC2AC\uB86F\uC5D0 \uC801\uD78C \uAE30\uBCF8
      \uACF5\uACA9\uB825\uC774 \uC790\uB3D9\uC73C\uB85C \uC2DC\uC804\uB41C\uB2F5\uB2C8\uB2E4."
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 60
    characterName: ALICE
    text: "[SYSTEM] \uC798\uD588\uC5B4\uC694! \uBC29\uAE08 \uBCF4\uC558\uB4EF\uC774
      \uAC00\uC7A5 \uC67C\uCABD \uC2AC\uB86F\uBD80\uD130 \uC624\uB978\uCABD \uC21C\uC11C\uB300\uB85C
      \uD6A8\uACFC\uAC00 \uBC1C\uB3D9\uD574\uC694."
    nextId: 61
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 61
    characterName: ALICE
    text: "[TIP] \uB610\uD55C \uBC29\uC5B4\uB825\uC740 \uC774\uBC88 \uD134\uC5D0\uB9CC
      \uC720\uD6A8\uD558\uB2F5\uB2C8\uB2E4!\\n\uC801\uC758 \uACF5\uACA9\uC744 \uB9C9\uACE0
      \uC2F6\uB2E4\uBA74, \uBC18\uB4DC\uC2DC \uC801\uC758 \uACF5\uACA9 \uC2AC\uB86F\uBCF4\uB2E4
      \uC67C\uCABD\uC5D0 \uBC29\uC5B4 \uCE74\uB4DC\uB97C \uBC30\uCE58\uD574 \uC8FC\uC138\uC694!"
    nextId: 62
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 62
    characterName: ALICE
    text: "[TIP] \uC544, \uCC38! \uCE74\uB4DC\uB97C \uAF2D \uB4DC\uB798\uADF8\uD560
      \uD544\uC694\uB294 \uC5C6\uC5B4\uC694.\\n\uCE74\uB4DC\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C
      \uC62C\uB9AC\uACE0 1, 2, 3, 4, 5 \uB610\uB294 S, D, F, G, H \uD0A4\uB97C \uB204\uB974\uBA74
      \uD574\uB2F9 \uC704\uCE58\uB85C \uCE74\uB4DC\uAC00 \uC790\uB3D9 \uBC30\uCE58\uB3FC\uC694!"
    nextId: 63
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 63
    characterName: ALICE
    text: "[TIP] \uD134 \uC885\uB8CC\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC608\uC694.
      \uAF2D \uBC84\uD2BC\uC744 \uB204\uB97C \uD544\uC694 \uC5C6\uC774 \uC2A4\uD398\uC774\uC2A4\uBC14\uB9CC
      \uB20C\uB7EC\uB3C4 \uBC14\uB85C \uD134\uC774 \uC885\uB8CC\uB3FC\uC694!"
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 70
    characterName: ALICE
    text: "[NOTICE] \uCC98\uC74C \uBCF4\uB294 \uC2AC\uB86F\uC774 \uB4F1\uC7A5\uD588\uAD70\uC694!
      \uB2F9\uD669\uD558\uC9C0 \uC54A\uC544\uB3C4 \uAD1C\uCC2E\uC544\uC694. \uC81C\uAC00
      \uC788\uC73C\uB2C8\uAE4C\uC694."
    nextId: 71
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 71
    characterName: ALICE
    text: "[GUIDE] \uD574\uB2F9 \uC2AC\uB86F\uC740 \uD134 \uC885\uB8CC\uB97C \uB204\uB974\uAE30
      \uC804\uAE4C\uC9C0 \uB204\uAD6C\uC758 \uC2AC\uB86F\uC778\uC9C0 \uC54C \uC218
      \uC5C6\uB294 \uC2AC\uB86F\uC774\uC5D0\uC694."
    nextId: 72
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 72
    characterName: ALICE
    text: "[TIP] \uAC15\uB825\uD55C \uCE74\uB4DC\uB97C \uB193\uACE0 \uB2F9\uC2E0\uC758
      \uC2AC\uB86F\uC774\uAE38 \uBE4C\uAC70\uB098, \uC57D\uD55C \uCE74\uB4DC\uB97C
      \uB193\uACE0 \uC548\uC804\uD558\uAC8C \uC9C4\uD589\uD558\uAC70\uB098. \uB2F9\uC2E0\uC758
      \uD310\uB2E8\uC774\uC5D0\uC694."
    nextId: 73
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 73
    characterName: ALICE
    text: "[SYSTEM] \uADF8\uB798\uC11C \uB204\uAD6C\uC758 \uC2AC\uB86F\uC774\uB0D0\uACE0\uC694?
      \uC74C... \uADF8\uB7F0 \uC9C8\uBB38\uC740 \uACE4\uB780\uD574\uC694. \uB2F9\uC2E0\uC758
      \uD310\uB2E8\uC744 \uAE30\uB300\uD560\uAC8C\uC694!"
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 80
    characterName: ALICE
    text: "[NOTICE] \uC2AC\uB86F \uC704\uC5D0 \uC22B\uC790\uAC00 \uB4F1\uC7A5\uD588\uB124\uC694.
      \uB611\uB611\uD55C \uB2F9\uC2E0\uC774\uB77C\uBA74 \uBB34\uC2A8 \uB73B\uC778\uC9C0
      \uC54C \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD574\uC694."
    nextId: 81
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 81
    characterName: ALICE
    text: "[GUIDE] \uADF8\uB798\uB3C4 \uD639\uC2DC \uBAB0\uB77C \uC124\uBA85\uD558\uC790\uBA74,
      \uD574\uB2F9 \uC2AC\uB86F\uC5D0 \uB193\uC740 \uCE74\uB4DC\uB294 \uC704\uC5D0
      \uC801\uD78C \uC22B\uC790\uC758 + \uB610\uB294 - \uBCF4\uC815\uC744 \uC801\uC6A9\uBC1B\uC544\uC694."
    nextId: 82
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 82
    characterName: ALICE
    text: "[TIP] -\uC758 \uACBD\uC6B0 0 \uBBF8\uB9CC\uC73C\uB85C \uB5A8\uC5B4\uC9C0\uC9C4
      \uC54A\uC73C\uB2C8 \uCC38\uACE0\uD558\uC138\uC694!"
    nextId: 83
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 83
    characterName: ALICE
    text: "[SYSTEM] \uADF8\uB7FC, \uC2B9\uB9AC\uB97C \uAE30\uC6D0\uD560\uAC8C\uC694!"
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 90
    characterName: ALICE
    text: "[SYSTEM] \uC548\uB155! ALICE\uC608\uC694. \uC774\uBC88\uC5D4 \uC65C \uB4F1\uC7A5\uD588\uB0D0\uACE0\uC694?"
    nextId: 91
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 91
    characterName: ALICE
    text: "[GUIDE] \uC74C... \uBC29\uC5B4 \uCE74\uB4DC\uB97C \uD55C \uBC88 \uBC30\uCE58\uD574
      \uBCFC\uB798\uC694?"
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 92
    characterName: ALICE
    text: "[SYSTEM] \uB124, \uB9DE\uC544\uC694. \uC704\uC5D0 \uC801\uD600 \uC788\uB294
      \uD574\uB2F9 \uCE74\uB4DC \uD0C0\uC785\uC740 \uC81C\uAC00 \uC774\uBC88 \uC804\uD22C\uC5D0\uC120
      \"\uAE08\uC9C0\"\uD588\uC5B4\uC694."
    nextId: 93
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 93
    characterName: ALICE
    text: "[NOTICE] \uB108\uBB34 \uC6D0\uB9DD\uD558\uC9C4 \uB9D0\uC544\uC694. \uB2F9\uC2E0\uC774
      \uB108\uBB34 \uC798\uD574\uC11C \uC2DC\uD5D8\uD574 \uBCF4\uACE0 \uC2F6\uC5C8\uC744
      \uBFD0\uC774\uB2C8\uAE4C\uC694.\\n\uC774\uBC88 \uC804\uD22C\uC5D0\uC11C\uB3C4
      \uC0B4\uC544\uB0A8\uC744 \uC218 \uC788\uC744 \uAC70\uB77C\uACE0 \uBBFF\uC5B4\uC694!"
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 100
    characterName: ALICE
    text: "[SYSTEM] \uC815\uBE44\uC18C\uC5D0\uC120 \uAE34\uC7A5\uD560 \uD544\uC694
      \uC5C6\uC5B4\uC694.\\n\uB2F9\uC2E0\uC5D0\uAC8C \uC704\uD611\uC774 \uB420 \uB9CC\uD55C
      \uAC83\uB4E4\uC740 \uC81C\uAC00 \uBBF8\uB9AC \uCE58\uC6CC\uB450\uC5C8\uC5B4\uC694."
    nextId: 101
    portraitPath: Dialogue/Guide
    expression: Normal
