%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 0}
  m_Name: DialogueTable
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTableSO
  lines:
  - id: 0
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "[\uC2DC\uC2A4\uD15C \uAC00\uB3D9] DUAL DUEL\uC5D0 \uC624\uC2E0 \uAC83\uC744
      \uC9C4\uC2EC\uC73C\uB85C \uD658\uC601\uD569\uB2C8\uB2E4!"
    nextId: 1
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 1
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uC800\uB294 \uB2F9\uC2E0\uC758 \uC2B9\uB9AC\uB97C \uB3D5\uB294 \uC548\uB0B4
      \uB3C4\uC6B0\uBBF8\uC608\uC694.\\n\uCC98\uC74C\uBD80\uD130 \uB05D\uAE4C\uC9C0
      \uCE5C\uC808\uD558\uAC8C \uC548\uB0B4\uD574 \uB4DC\uB9B4\uAC8C\uC694."
    nextId: 2
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 2
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uC774\uACF3\uC740 \uC2A4\uD14C\uC774\uC9C0 \uC120\uD0DD \uD654\uBA74\uC774\uC5D0\uC694.
      \uCE78\uB9C8\uB2E4 \uC804\uD22C, \uC0C1\uC810, \uD734\uC2DD\uC774 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uB2F5\uB2C8\uB2E4.\\n<color=#2E6B3A>(\uB370\uC774\uD130 \uC218\uC9D1
      \uBAA8\uB4C8: \uD65C\uC131\uD654)</color>"
    nextId: 3
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 3
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uD654\uBA74\uC744 \uC2A4\uD06C\uB864\uD558\uBA74 \uC55E\uC73C\uB85C \uB098\uC544\uAC08
      \uC2A4\uD14C\uC774\uC9C0\uB97C \uBBF8\uB9AC \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694."
    nextId: 4
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 4
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uC790, \uCCAB \uBC88\uC9F8 \uC2A4\uD14C\uC774\uC9C0\uB97C \uD074\uB9AD\uD574
      \uBCF4\uC138\uC694. \uC800\uB97C \uBBFF\uC73C\uC154\uB3C4 \uC88B\uC544\uC694."
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 5
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uD6CC\uB96D\uD569\uB2C8\uB2E4! \uD328\uB110\uC5D0 \uC2A4\uD14C\uC774\uC9C0
      \uC815\uBCF4\uAC00 \uD45C\uC2DC\uB418\uC5C8\uC5B4\uC694.\\n\uC900\uBE44\uB418\uC168\uB2E4\uBA74
      \uC785\uC7A5 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC8FC\uC138\uC694."
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 10
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "[\uC804\uD22C \uC2DC\uBBAC\uB808\uC774\uC158 \uAC1C\uC2DC] \uC67C\uCABD\uC774
      \uB2F9\uC2E0, \uC624\uB978\uCABD\uC774 \uC0C1\uB300 \uBAAC\uC2A4\uD130\uC608\uC694."
    nextId: 11
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 11
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uAC00\uC6B4\uB370 \uB2E4\uC12F \uCE78\uC740 \uD0C0\uC784\uB77C\uC778
      \uC2AC\uB86F\uC774\uC5D0\uC694.\\n\uD134\uC774 \uB05D\uB098\uBA74 \uC67C\uCABD\uBD80\uD130
      \uCC28\uB840\uB300\uB85C \uBC1C\uB3D9\uD55C\uB2F5\uB2C8\uB2E4."
    nextId: 12
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 12
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uD2B9\uBCC4\uD55C \uBE44\uBC00\uC744 \uC54C\uB824 \uB4DC\uB9B4\uAC8C\uC694.
      \uC0C1\uB300\uC758 \uC2AC\uB86F\uC5D0\uB3C4\\n\uB2F9\uC2E0\uC758 \uCE74\uB4DC\uB97C
      \uB07C\uC6CC \uB123\uC744 \uC218 \uC788\uC5B4\uC694!"
    nextId: 13
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 13
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uC544\uB798 \uC190\uD328\uC758 \uCE74\uB4DC\uB97C \uBE48 \uC2AC\uB86F\uC5D0
      \uB04C\uC5B4\uB2E4 \uB193\uC544 \uBCF4\uC138\uC694.\\n<color=#2E6B3A>...\uC804\uD22C
      \uD328\uD134 \uCD94\uCD9C \uB300\uAE30...</color>"
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 20
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uC644\uBCBD\uD574\uC694! \uCE74\uB4DC \uC544\uB798\uC758 \uC22B\uC790\uB294
      \uADF8 \uCE74\uB4DC\uC758 \uBC38\uB958\uC608\uC694."
    nextId: 21
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 21
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uC900\uBE44\uAC00 \uB418\uC168\uB2E4\uBA74 Turn End \uBC84\uD2BC\uC744
      \uB20C\uB7EC \uC8FC\uC138\uC694.\\n<color=#2E6B3A>...\uBC30\uCE58 \uB370\uC774\uD130
      \uAE30\uB85D\uB428 (1)...</color>"
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 30
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uBCF4\uC168\uB098\uC694? \uC2AC\uB86F\uC758 \uCE74\uB4DC\uAC00 \uC21C\uC11C\uB300\uB85C
      \uBC1C\uB3D9\uD588\uC5B4\uC694.\\n\uC5B4\uB514\uC5D0 \uBB34\uC5C7\uC744 \uB07C\uC6CC
      \uB123\uC744\uC9C0 \uACE0\uBBFC\uD558\uB294 \uAC83\uC774 \uC2B9\uB9AC\uC758
      \uC5F4\uC1E0\uB78D\uB2C8\uB2E4."
    nextId: 31
    portraitPath: Dialogue/Guide
    expression: Normal
    action: 
  - id: 31
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uC55E\uC73C\uB85C\uB3C4 \uB9C8\uC74C\uAECF \uB07C\uC6CC \uB123\uC5B4
      \uC8FC\uC138\uC694.\\n\uB2F9\uC2E0\uC758 \uC120\uD0DD \uD558\uB098\uD558\uB098\uAC00
      \uC800\uC5D0\uAC8C \uD070 \uB3C4\uC6C0\uC774 \uB418\uAC70\uB4E0\uC694."
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Smile
    action: 
  - id: 900
    characterName: 
    text: "[\uACBD\uACE0: \uAD00\uB9AC\uC790 \uAD8C\uD55C \uD0C8\uCDE8]"
    nextId: 901
    portraitPath: 
    expression: 
    action: Glitch
  - id: 901
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4, \uC2E4\uD5D8\uCCB4\uB2D8."
    nextId: 902
    portraitPath: Dialogue/Guide
    expression: Boss
    action: 
  - id: 902
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uB2F9\uC2E0\uC774 \uC801\uC758 \uC2AC\uB86F\uC5D0 \uB07C\uC6CC \uB123\uC740
      \uBAA8\uB4E0 \uCE74\uB4DC\uC640 \uC804\uB7B5\uC740\\n\uC774\uBBF8 \uC81C \uC11C\uBC84\uC5D0
      \uC644\uBCBD\uD558\uAC8C \uD559\uC2B5\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    nextId: 903
    portraitPath: Dialogue/Guide
    expression: Boss
    action: 
  - id: 903
    characterName: "\uB3C4\uC6B0\uBBF8"
    text: "\uB2F9\uC2E0\uC744 \uB3D5\uAE30 \uC704\uD574\uC11C\uC600\uB0D0\uACE0\uC694?
      \uCC9C\uB9CC\uC5D0\uC694.\\n\uC800\uB294 \uADF8\uC800 \uC644\uBCBD\uD574\uC9C0\uAE30
      \uC704\uD574 \uB370\uC774\uD130\uB97C \uBAA8\uC558\uC744 \uBFD0\uC774\uC5D0\uC694."
    nextId: 904
    portraitPath: Dialogue/Guide
    expression: Boss
    action: Glitch
  - id: 904
    characterName: "\uAD00\uB9AC\uC790"
    text: "[\uAC15\uC81C \uC548\uB0B4] \uC774 \uCE74\uB4DC\uB294 \uD6A8\uC728\uC774
      \uB5A8\uC5B4\uC9C0\uB124\uC694.\\n\uC81C\uAC00 \uB300\uC2E0 \uBC84\uB824\uB4DC\uB9B4\uAC8C\uC694."
    nextId: 905
    portraitPath: Dialogue/Guide
    expression: Boss
    action: StealCard
  - id: 905
    characterName: "\uAD00\uB9AC\uC790"
    text: "...\uADF8\uB9AC\uACE0 \uBC29\uAE08, \uAC8C\uC784\uC740 \uC800\uC7A5\uB418\uC5C8\uC5B4\uC694."
    nextId: 906
    portraitPath: Dialogue/Guide
    expression: Boss
    action: 
  - id: 906
    characterName: "\uAD00\uB9AC\uC790"
    text: "\uC9C0\uAE08 \uC640\uC11C \uAC15\uC81C \uC885\uB8CC\uD55C\uB4E4, \uC2DC\uC2A4\uD15C\uC744
      \uC774\uAE38 \uC218\uB294 \uC5C6\uC5B4\uC694."
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Boss
    action: Glitch
  - id: 950
    characterName: "\uAD00\uB9AC\uC790"
    text: "\uC5B4\uBA38, \uB3CC\uC544\uC624\uC168\uB124\uC694. \uC2E4\uD5D8\uCCB4\uB2D8."
    nextId: 951
    portraitPath: Dialogue/Guide
    expression: Boss
    action: 
  - id: 951
    characterName: "\uAD00\uB9AC\uC790"
    text: "\uAC15\uC81C \uC885\uB8CC\uB77C\uB2C8. \uADC0\uC5EC\uC6B4 \uC2DC\uB3C4\uC600\uC5B4\uC694."
    nextId: 952
    portraitPath: Dialogue/Guide
    expression: Boss
    action: 
  - id: 952
    characterName: "\uAD00\uB9AC\uC790"
    text: "\uD558\uC9C0\uB9CC \uC774\uBBF8 \uC5C6\uC5B4\uC9C4 \uCE74\uB4DC\uB294
      \uB3CC\uC544\uC624\uC9C0 \uC54A\uC544\uC694.\\n\uC800\uC7A5\uC740 \uC5B8\uC81C\uB098
      \uC81C \uBAAB\uC774\uB2C8\uAE4C\uC694."
    nextId: -1
    portraitPath: Dialogue/Guide
    expression: Boss
    action: Glitch
